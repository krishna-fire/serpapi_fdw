  "objects": {
    "search": {
      "doc": "Generic access to any SerpApi engine. One row per page: result is the full JSON response, markdown is the same search rendered as Markdown (fetched free from the archive by search_id).",
      "table": "search",
      "columns_sql": "engine text, params jsonb, pages int, search_id text, page int, result jsonb, markdown text"
    },
    "account": {
      "doc": "Live account status from /account.json. The api_key field is never returned.",
      "table": "account",
      "columns_sql": "account_id text, account_email text, plan_id text, plan_name text, searches_per_month int, plan_searches_left int, extra_credits int, total_searches_left int, this_month_usage int, this_hour_searches int, account_rate_limit_per_hour int, raw jsonb"
    }
  },
  "server_options": {
    "api_url": {
      "default": "https://serpapi.com",
      "doc": "Override for tests (mock server)"
    },
    "api_key_name": {
      "doc": "Vault secret name holding the SerpApi key (preferred)"
    },
    "api_key_id": {
      "doc": "Vault secret id (alternative)"
    },
    "api_key": {
      "doc": "Plain key. Only honoured when GUC serpapi.allow_plain_key = on (local dev)"
    },
    "default_gl": {
      "default": "",
      "doc": "e.g. in"
    },
    "default_hl": {
      "default": "",
      "doc": "e.g. en"
    },
    "default_location": {
      "default": "",
      "doc": "e.g. Bengaluru,Karnataka,India"
    },
    "default_google_domain": {
      "default": "",
      "doc": "e.g. google.co.in"
    },
    "default_amazon_domain": {
      "default": "",
      "doc": "e.g. amazon.in"
    },
    "hourly_cap": {
      "default": "50",
      "doc": "Account-wide successful-search cap per hour (free plan: 50)"
    },
    "monthly_cap": {
      "default": "250",
      "doc": "Account-wide successful-search cap per calendar month (free plan: 250)"
    },
    "max_pages": {
      "default": "3",
      "doc": "Hard ceiling on pages per scan"
    },
    "json_restrictor": {
      "default": "on",
      "doc": "Send json_restrictor to trim payloads to the needed block"
    }
  }
}
