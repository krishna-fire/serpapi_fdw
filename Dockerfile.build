# Reproducible builder for serpapi_fdw. Used by scripts/build.sh --docker and by CI.
# Matches supabase/wrappers' release workflow: Rust 1.97.1, wasm32-unknown-unknown,
# cargo-component 0.21.1.
FROM rust:1.97-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN rustup toolchain install 1.97.1 --profile minimal --component rustfmt --component clippy \
 && rustup default 1.97.1 \
 && rustup target add wasm32-unknown-unknown \
 && cargo install --locked cargo-component --version 0.21.1

WORKDIR /work
ENV CARGO_TARGET_DIR=/work/target
