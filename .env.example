# serpapi_fdw — local development
# The wrapper reads the key from Supabase Vault (secret name `serpapi_api_key`);
# scripts/load-local.sh puts it there from this variable or from ~/.serpapi_key.
SERPAPI_API_KEY=

# Optional: point the foreign server at the fixture mock instead of serpapi.com
# SERPAPI_BASE=http://host.docker.internal:8787
